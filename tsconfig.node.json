{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": ["vite.config.*", "cypress.config.*", "nightwatch.conf.*", "playwright.config.*"]
}
